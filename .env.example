# handles.link configuration. Copy to .env.local and fill in. Every value
# is NEXT_PUBLIC_ (inlined into the client bundle) — nothing here is a
# secret. A missing platform-specific value disables that platform's
# button; it never crashes the app.
#
# For local development against the libid compose harness, `harness/boot.sh`
# in a libid checkout prints (and renders) these exact values — see the
# README's "Run locally" section.

# ── Required for everything (bind + resolve) ───────────────────────────────
# IdentityNames contract address on the target chain.
NEXT_PUBLIC_IDENTITY_NAMES_ADDRESS=0x84ea74d481ee0a5332c457a4d796187f6ba67feb
# JSON-RPC endpoint of that chain.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# EVM chain id, decimal. The wallet guard checks it, and the Google
# circuit commits it.
NEXT_PUBLIC_CHAIN_ID=31337

# ── GitHub (also used by Google's redirect) ────────────────────────────────
# identity-backend origin: mints the GitHub challenge/proof and serves the
# Google fragment relay. GitHub claims need nothing else — no staged
# assets, no notary.
NEXT_PUBLIC_API_URL=http://localhost:8722

# ── X ──────────────────────────────────────────────────────────────────────
# Notary endpoint (MPC-TLS / proxy-mode). ws(s) upgrade happens on the
# same origin.
NEXT_PUBLIC_NOTARY_WS_URL=http://127.0.0.1:7048
# OAuth 2.0 client id of the X app whose registered redirect is
# <this origin>/zk/x-popup.
NEXT_PUBLIC_X_CLIENT_ID=

# ── Google ─────────────────────────────────────────────────────────────────
# OAuth client id whose whitelisted redirect is
# <NEXT_PUBLIC_API_URL>/auth/gmail/callback.
NEXT_PUBLIC_GMAIL_CLIENT_ID=
# GoogleIdentityVerifier contract address — the SNARK is minted for it.
NEXT_PUBLIC_GOOGLE_IDENTITY_VERIFIER=
